# stavby-rag configuration. Loaded automatically (without a python-dotenv dependency) from
#   <cwd>/.env          - when you run `stavby` from a project checkout
#   $STAVBY_HOME/.env   - the installed home (default ~/.stavby; install.sh copies this file there)
# Values only fill in variables that are not already exported in your shell. Format: KEY=VALUE,
# `#` comments, optional quotes; an empty value leaves the default in place.
#
# Where data lives: STAVBY_HOME (alias STAVBY_ROOT) > the source checkout when run from one > ~/.stavby
# STAVBY_HOME=~/.stavby
# Corpus to use: unset = the crawled textbook in data/, otherwise data/corpora/<name>/
STAVBY_CORPUS=
# Optional: use Claude for answers (default backend when set)
ANTHROPIC_API_KEY=
STAVBY_ANTHROPIC_MODEL=claude-opus-5
# Local fallback
OLLAMA_HOST=http://localhost:11434
STAVBY_OLLAMA_MODEL=qwen3:14b
STAVBY_OLLAMA_THINK=1
STAVBY_OLLAMA_NUM_CTX=16384
# How long Ollama keeps a model loaded after a call (-1 = forever; `stavby serve`/`chat` use -1)
STAVBY_OLLAMA_KEEP_ALIVE=30m
# Context sizes for the retrieval models (chunks are ~700 tokens; smaller = less memory)
STAVBY_OLLAMA_EMBED_NUM_CTX=2048
STAVBY_OLLAMA_RERANK_NUM_CTX=2048
# Parallel reranker requests; only >1 if Ollama runs with OLLAMA_NUM_PARALLEL>1 (no gain measured on Metal)
STAVBY_RERANK_WORKERS=1
# Web server: require `Authorization: Bearer <token>` on /api/*; CORS origins (default *)
STAVBY_API_TOKEN=
STAVBY_CORS_ORIGINS=*
STAVBY_ANTHROPIC_EFFORT=high
# Embeddings: backend ollama | st (sentence-transformers/HF) | auto
STAVBY_EMBED_BACKEND=auto
STAVBY_OLLAMA_EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-8B-GGUF:Q8_0
STAVBY_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Reranker: backend ollama | st | none | auto
STAVBY_RERANK_BACKEND=auto
STAVBY_OLLAMA_RERANK_MODEL=dengcao/Qwen3-Reranker-8B:Q8_0
STAVBY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Reranked candidates per query: 20/12/8 measured identical on the 48q eval (section hit@1 88%);
# 12 reranks in ~21 s vs 34 s at 20 on an M4 Pro (docs/DESIGN.md has the numbers).
STAVBY_RERANK_POOL=12
# Per-source body characters in the answer prompt (0 = full ~1400-char chunk). 1000 = equal
# answer quality, ~7 s less prefill per query.
STAVBY_PROMPT_SOURCE_CHARS=1000
# Corporate networks with TLS interception: point Python at the macOS keychain CAs so
# HuggingFace downloads verify. Build the bundle once:
#   security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain > ~/ca.pem
#   security find-certificate -a -p /Library/Keychains/System.keychain >> ~/ca.pem
# SSL_CERT_FILE=~/ca.pem
# HF_HUB_DISABLE_XET=1
STAVBY_RERANK_FUSION=rrf
